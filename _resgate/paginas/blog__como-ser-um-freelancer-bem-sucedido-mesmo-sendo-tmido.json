cityEnabledOnProductBlocks":false,"scarcityMessageType":"DEFAULT_SCARCITY_MESSAGE","scarcityThreshold":10,"multipleQuantityAllowedForServices":false,"restockNotificationsEnabled":false,"restockNotificationsSuccessText":"","restockNotificationsMailingListSignUpEnabled":false,"relatedProductsEnabled":false,"relatedProductsOrdering":"random","customSoldOutText":"Esgotado","soldOutVariantsDropdownDisabled":false,"productComposerOptedIn":false,"productComposerABTestOptedOut":false,"productReviewsEnabled":false,"displayNativeProductReviewsEnabled":false,"displayImportedProductReviewsEnabled":false,"productReviewsDisplayScope":"ALL_REVIEWS","productReviewsMerchantEmailEnabled":false,"hasOptedToCollectNativeReviews":false},"minimumOrderSubtotalEnabled":false,"minimumOrderSubtotal":{"currency":"BRL","value":"0.00"},"addToCartConfirmationType":2,"isLive":false,"multipleQuantityAllowedForServices":false},"useEscapeKeyToLogin":false,"ssBadgeType":1,"ssBadgePosition":4,"ssBadgeVisibility":1,"ssBadgeDevices":1,"pinterestOverlayOptions":{"mode":"disabled"},"ampEnabled":false,"isRestrictiveCookiePolicyEnabled":false,"seoHidden":false,"userAccountsSettings":{"loginAllowed":false,"signupAllowed":false},"isCookieBannerEnabled":false,"isVisitorDataRestricted":false},"item":{"id":"654989eec438956c16df794e","collectionId":"65495b108dbeea7bd4c8e85e","recordType":1,"addedOn":1699318360897,"updatedOn":1701720291498,"starred":false,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1699318360897,"authorId":"5fa596f3b5102d57d6d765ae","systemDataId":"1701720275120-LCVHLCPN2A68NAI1AKTP","systemDataVariants":"2048x1080,100w,300w,500w,750w,1000w,1500w","systemDataSourceType":"JPG","filename":"Untitled_1.3.4.PRE.jpg","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"colorData":{"topLeftAverage":"3a3e41","topRightAverage":"131415","bottomLeftAverage":"212a33","bottomRightAverage":"29333c","centerAverage":"171c21","suggestedBgColor":"2e373f"},"urlId":"como-ser-um-freelancer-bem-sucedido-mesmo-sendo-tmido","title":"Como ser um Freelancer bem-sucedido mesmo sendo T\u00CDMIDO","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-654989eec438956c16df794e\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/404e5f08-980a-46ab-b8a4-b636be9c2360_866/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/404e5f08-980a-46ab-b8a4-b636be9c2360_866/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"7123bd23b80fbd8a7679\" id=\"block-7123bd23b80fbd8a7679\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Ser um freelancer exige algumas habilidades que n\u00E3o t\u00EAm rela\u00E7\u00E3o uma com a outra:</p><ol data-rte-list=\"default\"><li><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">o conhecimento t\u00E9cnico do servi\u00E7o que \u00E9 vendido</p></li><li><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">o conhecimento de vendas e marketing para conseguir vender aquele servi\u00E7o.</p></li></ol><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">E o problema \u00E9 que seguidamente essas habilidades n\u00E3o est\u00E3o presentes na mesma pessoa.</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">\u00C9 quando admitimos que somos t\u00EDmidos que percebemos que demorar\u00EDamos muito tempo para nos tornarmos realmente bons em vendas. Ter sucesso como um freelancer com caracter\u00EDsticas introvertidas pode ser um desafio enorme.</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">E eu poderia me usar como exemplo, porque afinal, desde que sou crian\u00E7a percebo que n\u00E3o sou uma pessoa extrovertida. Nunca fui de conviver com muita gente, e tenho uma leve fobia social at\u00E9 hoje, apesar de eu j\u00E1 ter resolvido a maioria desse problema. Portanto, a ideia de entrar em contato com um prospecto/cliente por dia j\u00E1 me fazia ter v\u00E1rios tipos de rea\u00E7\u00F5es negativas.</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">E ainda assim eu tentei por muito tempo. Quase sempre era de longe a pior parte do meu dia.</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Eu originalmente me arrisquei como freelancer porque queria viver de uma coisa que eu gostava e n\u00E3o precisar necessariamente depender de um trabalho, de uma outra empresa, e de um chefe, e no entanto eu estava sofrendo com a sensa\u00E7\u00E3o de ser escravo de algumas das tarefas (as que envolviam vendas), ao inv\u00E9s de sentir a liberdade que supostamente eu deveria sentir, e que foi um dos principais motivos do porqu\u00EA eu me arrisquei nesse neg\u00F3cio, pra come\u00E7ar. Alguma coisa n\u00E3o estava certa.</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Mas ent\u00E3o se vender, fazer o marketing pessoal, o networking e a negocia\u00E7\u00E3o eram problemas enormes, como resolv\u00EA-los e ainda assim conseguir ter o Color Grading como meu trabalho? Com o tempo eu finalmente achei uma solu\u00E7\u00E3o: terceirizar todas essas tarefas.</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Obviamente a habilidade em Color Grading (ou em qualquer que seja o servi\u00E7o que voc\u00EA est\u00E1 vendendo), \u00E9 importante. Na verdade, eu diria que ela \u00E9 o m\u00EDnimo que voc\u00EA precisa ter. E \u00E9 s\u00F3 dessa forma que voc\u00EA consegue vender o seu trabalho e continuar no mercado. Porque afinal, por melhor que voc\u00EA fa\u00E7a a venda, os clientes s\u00F3 v\u00E3o voltar e falar positivamente de ti para os outros caso a entrega do servi\u00E7o tenha sido uma boa experi\u00EAncia.</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">No entanto, decidi finalmente aplicar aquelas famosas frases do Steve Jobs e portanto contratar gente pra fazer o trabalho que eu havia demorado tanto pra admitir que eu n\u00E3o era muito bom: \u201CConcentre-se no que voc\u00EA \u00E9 bom. Delegue todo o resto.\u201D</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">E se voc\u00EA est\u00E1 pensando em seguir \u00E0 diante com esse dica incr\u00EDvel que eu te dei, aqui v\u00E3o algumas dicas que eu queria que tivessem me passado quando eu precisei contratar a minha primeira vendedora:</p><h2 style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\">As op\u00E7\u00F5es que voc\u00EA tem</h2><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Primeiro de tudo \u00E9 importante saber que existem diversas op\u00E7\u00F5es:</p><ol data-rte-list=\"default\"><li><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Contratar um Freelancer</p></li><li><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Contratar uma Ag\u00EAncia</p></li><li><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Ter um S\u00F3cio</p></li></ol><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">\u00C9 importante destacar que independente de qual dessas op\u00E7\u00F5es voc\u00EA vai preferir escolher, saiba que quanto melhor for a comunica\u00E7\u00E3o entre voc\u00EAs, tanto em rela\u00E7\u00E3o ao que \u00E9 esperado da pessoa quanto tamb\u00E9m como fica o pagamento, por exemplo, melhor. Quanto melhor voc\u00EAs se entenderem, melhor para voc\u00EA e para o seu neg\u00F3cio.</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">A primeira op\u00E7\u00E3o foi a que eu decidi seguir na minha empresa. Isso porque ela te permite que voc\u00EA n\u00E3o tenha nenhum v\u00EDnculo patr\u00E3o-funcion\u00E1rio, legalmente falando, e isso me permite que eu pague um valor que faz sentido pra mim e pra pessoa tamb\u00E9m. Al\u00E9m disso, essa pessoa n\u00E3o fica amarrada comigo, e pode simplesmente ir embora \u00E0 qualquer momento. Al\u00E9m claro, de poder vender para outras empresas se quiser.</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Uma ag\u00EAncia que faz esse tipo de trabalho tamb\u00E9m \u00E9 uma op\u00E7\u00E3o. Essa empresa vai te permitir investir em marketing e prospectar clientes. No entanto, \u00E9 muito prov\u00E1vel que voc\u00EA continue sendo o respons\u00E1vel por fechar as vendas. O que pode ser ainda bem interessante, j\u00E1 que normalmente o que mais assusta o introvertido \u00E9 a prospec\u00E7\u00E3o, e n\u00E3o necessariamente o fechamento da venda.</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">E por \u00FAltimo, sempre \u00E9 poss\u00EDvel ter um s\u00F3cio que sabe vender. Esse cara vai assumir o risco junto contigo, e vai ser pago apenas se as vendas derem resultado. No entanto, no futuro, \u00E9 importante que voc\u00EA saiba que parte da sua empresa vai ser dele.</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Mas independente da forma que voc\u00EA decidir seguir adiante, saiba que um neg\u00F3cio s\u00F3 funciona se ele vende. E portanto, algu\u00E9m que sabe vender de verdade precisa estar na equipe de alguma forma.</p><h2 style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\">Como fazer a contrata\u00E7\u00E3o</h2><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Chances s\u00E3o que, \u00E0 essa altura do texto, voc\u00EA j\u00E1 tenha em mente algumas pessoas que seriam \u00F3timas candidatas \u00E0 serem os seus vendedores. E se n\u00E3o, voc\u00EA sempre pode tentar lembrar de algu\u00E9m pr\u00F3ximo que talvez j\u00E1 tenha trabalhado como vendedor em algum lugar. Caso n\u00E3o houver ningu\u00E9m, sempre \u00E9 poss\u00EDvel usar as suas redes sociais para anunciar a vaga de emprego.</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Mas mais dif\u00EDcil do que encontrar gente para isso, a principal pergunta \u00E9: \u201Ccomo eu seleciono a pessoa certa, uma vez que eu j\u00E1 tenho uma lista de candidatos?\u201D</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Eu poderia citar talvez uma dezena de caracter\u00EDsticas que uma pessoa pode ter para ser o seu vendedor. Mas a verdade \u00E9 que a maioria delas voc\u00EA mesmo vai decidir. Dito isso, tem sim uma important\u00EDssima que precisa ficar claro para voc\u00EA desde j\u00E1: fome de sucesso. Ambi\u00E7\u00E3o.</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Essa caracter\u00EDstica \u00E9 importante, porque o vendedor \u00E9 a pessoa que mais diretamente recebe mais dinheiro quando d\u00E1 mais resultado para a empresa. Ou seja, quanto mais ela vender, mais dinheiro ela faz, sem precisar passar pela burocracia do chefe precisar perceber e dar um aumento, porque o vendedor \u00E9 o \u00FAnico que tem comiss\u00E3o.</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Dessa maneira, o \u00FAnico pr\u00E9-requisito que todo vendedor precisa ter \u00E9 o desejo profundo de se tornar maior, mais rico, e mais bem-sucedido. O suficiente para que ele trabalhe mais. Inclusive, via de regra esse desejo v\u00EAm de um prop\u00F3sito bem nobre: aposentar os pais, colocar os filhos em uma escola melhor, etc.</p><h2 style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\">Como isso funciona na pr\u00E1tica</h2><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Na pr\u00E1tica, eu sugiro que voc\u00EA pague um valor fixo por m\u00EAs para essa pessoa, mesmo que seja pouco, e d\u00EA uma boa porcentagem de comiss\u00E3o pra ela. Se conseguir algu\u00E9m que est\u00E1 disposto a trabalhar somente pela comiss\u00E3o, pode ser uma boa dica tamb\u00E9m.</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">No entanto, nem tudo s\u00E3o rosas. Voc\u00EA agora tem o trabalho de gerenciar o vendedor. E portanto, precisa prover os recursos necess\u00E1rios para que ele d\u00EA resultado, al\u00E9m de obviamente entregar um bom trabalho.</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Isso significa que provavelmente voc\u00EA vai precisar criar os roteiros de vendas, de prospec\u00E7\u00E3o e ter um site e um portf\u00F3lio bonitos, no m\u00EDnimo. Afinal, essas s\u00E3o as ferramentas que v\u00E3o permitir que o vendedor venda. E portanto, vai ser necess\u00E1rio que voc\u00EA aprenda a vender, mesmo que mais na teoria do que na pr\u00E1tica.</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Esse processo todo vai te liberar tempo para aumentar a sua receita, naturalmente, sem exigir do teu tempo, al\u00E9m de justamente te permitir se tornar um profissional melhor na parte t\u00E9cnica, e entrega. Al\u00E9m claro, de te deixar levemente mais tranquilo sabendo que o dia-a-dia de prospec\u00E7\u00E3o de novos clientes est\u00E1 em boas m\u00E3os treinadas por voc\u00EA mesmo.</p><h2 style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\">E se o vendedor vender muito?</h2><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Algumas obje\u00E7\u00F5es talvez ainda tenham ficado, e eu quero sugerir solu\u00E7\u00F5es pra elas.</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">\u201CE se o vendedor vender muito?\u201D \u00E9 uma cl\u00E1ssica.</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Eu conhe\u00E7o talvez algumas dezenas de coloristas que estariam dispostos \u00E0 pegar projetos que eu vendi, caso aconte\u00E7a de eu n\u00E3o dar conta de colorir tudo o que foi vendido. E honestamente, eu sugiro que voc\u00EA fa\u00E7a o mesmo. Talvez tamb\u00E9m voc\u00EA queira pensar em subir o seu pre\u00E7o, caso esteja com a agenda lotada, e uma alternativa seria treinar algu\u00E9m na sua arte, para que essa pessoa consiga entregar resultados t\u00E3o bons quanto os seus.</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Mas ao mesmo tempo \u00E9 importante destacar que provavelmente um vendedor n\u00E3o vai fazer milagre, e tamb\u00E9m que esse \u00E9 um problema bom, e quase todo colorista t\u00EAm inveja de voc\u00EA.</p><h2 style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\">E se o vendedor n\u00E3o vender nada?</h2><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">\u00C9 poss\u00EDvel que isso ocorra. Na verdade, pode ser que voc\u00EA precise passar por alguns vendedores at\u00E9 acertar um que venda a sua arte com qualidade. Dito isso, o risco \u00E9 mesmo real. Quanto mais voc\u00EA conseguir orientar o seu vendedor, melhor. No fim das contas a empresa \u00E9 sua.</p></div>\n\n\n  \n<style id=\"container-styles\">#block-7123bd23b80fbd8a7679 {\n    \n    \n    \n\n\n\n  }\n\n  #block-7123bd23b80fbd8a7679 .sqs-html-content {\n    \n    --tweak-text-block-padding: 6% 6% 6% 6%;\n  --tweak-text-block-padding: initial;\n}\n\n  #block-7123bd23b80fbd8a7679 {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      border-radius: var(--tweak-text-block-radius);\n  }\n\n  \n  \n#block-7123bd23b80fbd8a7679 {\n      --tweak-text-block-radius: 0px 0px 0px 0px;\n    }\n\n\n  \n  \n\n  #block-7123bd23b80fbd8a7679 {\n    }\n\n</style>\n\n<style id=\"override-container-styles\">\n    @media screen and (max-width: 767px) {\n          \n            \n\n#block-7123bd23b80fbd8a7679 {\n            \n            }\n        }\n    \n  \n    @media screen and (max-width: 767px) {\n          #block-7123bd23b80fbd8a7679 .sqs-html-content {\n            \n            }\n        }\n    \n  @media screen and (max-width: 767px) {\n          \n          \n\n          \n          \n          \n        }</style>\n<style class=\"transform-overrides-vars\">\n  \n</style>\n\n\n\n\n</div>\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-horizontalrule horizontalrule-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.horizontalrule/35dd1938-2d06-46fb-841f-fcae73aeb83d_233/website.components.horizontalrule.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.horizontalrule/35dd1938-2d06-46fb-841f-fcae73aeb83d_233/website.components.horizontalrule.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.horizontalrule\" data-sqsp-block=\"line\" data-website-component-id=\"yui_3_17_2_1_1699318256431_7964\" id=\"block-yui_3_17_2_1_1699318256431_7964\"><div class=\"sqs-block-content\">\n  \n\n\n<div>\n  <hr />\n  \n    <style class=\"transform-overrides-vars\">\n  \n</style>\n\n    \n\n\n\n  \n</div>\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/404e5f08-980a-46ab-b8a4-b636be9c2360_866/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/404e5f08-980a-46ab-b8a4-b636be9c2360_866/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"yui_3_17_2_1_1699318256431_8024\" id=\"block-yui_3_17_2_1_1699318256431_8024\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Caso voc\u00EA seja t\u00EDmido ou pelo menos introvertido, sugiro considerar fortemente essa estrat\u00E9gia o mais cedo que conseguir, para acelerar o seu crescimento. Afinal, essa \u00E9 uma \u00F3tima maneira de driblar os sentimentos negativos que v\u00EAm quando voc\u00EA tenta vender, e te permite focar no que voc\u00EA \u00E9 bom.</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Se voc\u00EA gostou desse conte\u00FAdo, me deixa eu te recomendar o meu canal de Telegram, onde eu crio um conte\u00FAdo por dia pra quem t\u00E1 l\u00E1: <a href=\"http://t.me/germanocolorgrading\">t.me/germanocolorgrading</a></p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">E tamb\u00E9m, se quiser entrar na minha Newsletter, pra n\u00E3o perder sempre que eu mando esse tipo de conte\u00FAdo, fica \u00E0 vontade: <a href=\"http://vertigocolor.com/newsletter\">vertigocolor.com/newsletter</a></p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Mais recentemente eu postei um podcast exatamente com esse tema: <a href=\"https://podcasters.spotify.com/pod/show/germano-michelon-santos/episodes/Como-viver-de-Color-Grading-mesmo-sendo-TMIDO-e2ao5ik\">https://podcasters.spotify.com/pod/show/germano-michelon-santos/episodes/Como-viver-de-Color-Grading-mesmo-sendo-TMIDO-e2ao5ik</a></p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Valeu!</p><p style=\"text-align:justify;white-space: normal !important;white-space:pre-wrap;\" class=\"\">Germano.</p></div>\n\n\n  \n<style id=\"container-styles\">#block-yui_3_17_2_1_1699318256431_8024 {\n    \n    \n    \n\n\n\n  }\n\n  #block-yui_3_17_2_1_1699318256431_8024 .sqs-html-content {\n    \n    --tweak-text-block-padding: 6% 6% 6% 6%;\n  --tweak-text-block-padding: initial;\n}\n\n  #block-yui_3_17_2_1_1699318256431_8024 {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      border-radius: var(--tweak-text-block-radius);\n  }\n\n  \n  \n#block-yui_3_17_2_1_1699318256431_8024 {\n      --tweak-text-block-radius: 0px 0px 0px 0px;\n    }\n\n\n  \n  \n\n  #block-yui_3_17_2_1_1699318256431_8024 {\n    }\n\n</style>\n\n<style id=\"override-container-styles\">\n    @media screen and (max-width: 767px) {\n          \n            \n\n#block-yui_3_17_2_1_1699318256431_8024 {\n            \n            }\n        }\n    \n  \n    @media screen and (max-width: 767px) {\n          #block-yui_3_17_2_1_1699318256431_8024 .sqs-html-content {\n            \n            }\n       