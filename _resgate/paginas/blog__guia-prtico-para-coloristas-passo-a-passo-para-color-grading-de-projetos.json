{"website":{"id":"627132feb555fb16cce33d60","captchaSettings":{"siteKey":"","enabledForDonations":false},"cloneable":false,"contentModifiedOn":1782836875784,"identifier":"buttercup-sponge-7nnm","imageMetadataProcessingEnabled":false,"isHstsEnabled":true,"language":"pt-BR","logoImageId":"6a049dee4a0e90559aacf688","primaryDomain":"www.vertigocolor.com","screenshotId":"444b9fab1db0d0ec9a860b849fd384378505ad9e85c152c982dfb387c8938319","shareButtonOptions":{"6":true,"8":true,"2":true,"4":true,"1":true,"7":true,"3":true},"showOwnerLogin":false,"siteDescription":"","siteStatus":{},"siteTitle":"Vertigo Color","sslSetting":3,"timeZone":"America/Sao_Paulo","typekitId":"","websiteType":1,"hasBeenCloneable":false,"statsMigrated":false,"authenticUrl":"https://www.vertigocolor.com","baseUrl":"https://www.vertigocolor.com","internalUrl":"https://buttercup-sponge-7nnm.squarespace.com","logoImageUrl":"//images.squarespace-cdn.com/content/v1/627132feb555fb16cce33d60/bef5dbe4-8f64-416c-a53c-b3af4bb3a5c6/Logo+Vertigo.png","machineTimeZoneOffset":-10800000,"socialAccounts":[{"serviceId":64,"screenname":"Instagram","addedOn":1651585791019,"profileUrl":"https://www.instagram.com/germanomichelon/","iconEnabled":true,"serviceName":"instagram-unauth"},{"serviceId":69,"screenname":"YouTube","addedOn":1721333861400,"profileUrl":"https://www.youtube.com/@GermanoMichelon","iconEnabled":true,"serviceName":"youtube-unauth"},{"serviceId":82,"screenname":"TikTok","addedOn":1721333899740,"profileUrl":"https://www.tiktok.com/@germanomichelon","iconEnabled":true,"serviceName":"tiktok-unauth"},{"serviceId":32,"screenname":"M\u00E9dio","addedOn":1721333913590,"profileUrl":"https://medium.com/@germanomichelon","iconEnabled":true,"serviceName":"medium"},{"serviceId":83,"screenname":"Threads","addedOn":1721333920047,"profileUrl":"https://www.threads.net/@germanomichelon","iconEnabled":true,"serviceName":"threads-unauth"},{"serviceId":71,"screenname":"Spotify","addedOn":1721334019858,"profileUrl":"https://po