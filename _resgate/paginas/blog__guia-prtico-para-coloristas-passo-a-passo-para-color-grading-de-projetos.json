cityEnabledOnProductBlocks":false,"scarcityMessageType":"DEFAULT_SCARCITY_MESSAGE","scarcityThreshold":10,"multipleQuantityAllowedForServices":false,"restockNotificationsEnabled":false,"restockNotificationsSuccessText":"","restockNotificationsMailingListSignUpEnabled":false,"relatedProductsEnabled":false,"relatedProductsOrdering":"random","customSoldOutText":"Esgotado","soldOutVariantsDropdownDisabled":false,"productComposerOptedIn":false,"productComposerABTestOptedOut":false,"productReviewsEnabled":false,"displayNativeProductReviewsEnabled":false,"displayImportedProductReviewsEnabled":false,"productReviewsDisplayScope":"ALL_REVIEWS","productReviewsMerchantEmailEnabled":false,"hasOptedToCollectNativeReviews":false},"minimumOrderSubtotalEnabled":false,"minimumOrderSubtotal":{"currency":"BRL","value":"0.00"},"addToCartConfirmationType":2,"isLive":false,"multipleQuantityAllowedForServices":false},"useEscapeKeyToLogin":false,"ssBadgeType":1,"ssBadgePosition":4,"ssBadgeVisibility":1,"ssBadgeDevices":1,"pinterestOverlayOptions":{"mode":"disabled"},"ampEnabled":false,"isRestrictiveCookiePolicyEnabled":false,"seoHidden":false,"userAccountsSettings":{"loginAllowed":false,"signupAllowed":false},"isCookieBannerEnabled":false,"isVisitorDataRestricted":false},"item":{"id":"65c377cca7b4665db9d4b5bc","collectionId":"65495b108dbeea7bd4c8e85e","recordType":1,"addedOn":1707309115200,"updatedOn":1707309141376,"starred":false,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1707309115200,"authorId":"5fa596f3b5102d57d6d765ae","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"urlId":"guia-prtico-para-coloristas-passo-a-passo-para-color-grading-de-projetos","title":"Guia Pr\u00E1tico para Coloristas: Passo-a-Passo para Color Grading de Projetos","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-65c377cca7b4665db9d4b5bc\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block image-block sqs-block-image\" data-block-type=\"5\" data-sqsp-block=\"image-classic\" id=\"block-yui_3_17_2_1_1707309116879_4602\"><div class=\"sqs-block-content\">\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n\n    \n  \n    <div\n        class=\"\n          image-block-outer-wrapper\n          layout-caption-below\n          design-layout-inline\n          combination-animation-site-default\n          individual-animation-site-default\n          individual-text-animation-site-default\n        \"\n        data-test=\"image-block-inline-outer-wrapper\"\n        data-sqsp-image-classic-block-layout=\"inline\"\n    >\n\n      \n\n      \n        <figure\n            class=\"\n              sqs-block-image-figure\n              intrinsic\n            \"\n            style=\"max-width:1440px;\"\n        >\n          \n        \n        \n\n        \n          \n            \n          <div\n              \n              \n              class=\"image-block-wrapper\"\n              data-animation-role=\"image\"\n              \n  \n\n          >\n            <div data-sqsp-image-classic-block-image-container class=\"sqs-image-shape-container-element\n              \n          \n        \n              has-aspect-ratio\n            \" style=\"\n                position: relative;\n                \n                  padding-bottom:41.875%;\n                \n                overflow: hidden;-webkit-mask-image: -webkit-radial-gradient(white, black);\n              \"\n              >\n                \n                \n                \n                \n                \n                \n                \n                <img data-stretch=\"false\" data-src=\"https://images.squarespace-cdn.com/content/v1/627132feb555fb16cce33d60/a47353ea-8430-45dc-8b80-483a08df40db/mini-panel-md.jpg\" data-image=\"https://images.squarespace-cdn.com/content/v1/627132feb555fb16cce33d60/a47353ea-8430-45dc-8b80-483a08df40db/mini-panel-md.jpg\" data-image-dimensions=\"1440x603\" data-image-focal-point=\"0.5,0.5\" alt=\"\" data-load=\"false\" elementtiming=\"system-image-block\" data-sqsp-image-classic-block-image src=\"https://images.squarespace-cdn.com/content/v1/627132feb555fb16cce33d60/a47353ea-8430-45dc-8b80-483a08df40db/mini-panel-md.jpg\" width=\"1440\" height=\"603\" alt=\"\" sizes=\"(max-width: 640px) 100vw, (max-width: 767px) 100vw, 100vw\" style=\"display:block;object-fit: cover; width: 100%; height: 100%; object-position: 50% 50%\" onload=\"this.classList.add(&quot;loaded&quot;)\" srcset=\"https://images.squarespace-cdn.com/content/v1/627132feb555fb16cce33d60/a47353ea-8430-45dc-8b80-483a08df40db/mini-panel-md.jpg?format=100w 100w, https://images.squarespace-cdn.com/content/v1/627132feb555fb16cce33d60/a47353ea-8430-45dc-8b80-483a08df40db/mini-panel-md.jpg?format=300w 300w, https://images.squarespace-cdn.com/content/v1/627132feb555fb16cce33d60/a47353ea-8430-45dc-8b80-483a08df40db/mini-panel-md.jpg?format=500w 500w, https://images.squarespace-cdn.com/content/v1/627132feb555fb16cce33d60/a47353ea-8430-45dc-8b80-483a08df40db/mini-panel-md.jpg?format=750w 750w, https://images.squarespace-cdn.com/content/v1/627132feb555fb16cce33d60/a47353ea-8430-45dc-8b80-483a08df40db/mini-panel-md.jpg?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/627132feb555fb16cce33d60/a47353ea-8430-45dc-8b80-483a08df40db/mini-panel-md.jpg?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/627132feb555fb16cce33d60/a47353ea-8430-45dc-8b80-483a08df40db/mini-panel-md.jpg?format=2500w 2500w\" loading=\"lazy\" decoding=\"async\" data-loader=\"sqs\">\n\n            </div>\n          </div>\n        \n          \n        \n\n        \n      \n        </figure>\n      \n\n    </div>\n  \n\n\n  \n\n\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/404e5f08-980a-46ab-b8a4-b636be9c2360_866/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/404e5f08-980a-46ab-b8a4-b636be9c2360_866/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"f464780f69740ea006b8\" id=\"block-f464780f69740ea006b8\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p class=\"\" style=\"white-space:pre-wrap;\">Desde o come\u00E7o, j\u00E1 quero deixar claro que existe sim um passo-a-passo que voc\u00EA pode seguir em praticamente TODOS os projetos que \u00E9 a base do que Hollywood faz, e que vai te permitir ser criativo, manter a consist\u00EAncia, qualidade de trabalho, e a efetividade durante o Color Grading (e talvez, com sorte, tamb\u00E9m desenvolver um estilo pr\u00F3prio).</p><p class=\"\" style=\"white-space:pre-wrap;\">Ent\u00E3o, j\u00E1 sugiro que voc\u00EA salve nos favoritos essa p\u00E1gina para que voc\u00EA possa consultar ao longo de cada projeto at\u00E9 se acostumar e conseguir fazer naturalmente, sem o meu aux\u00EDlio.</p><p class=\"\" style=\"white-space:pre-wrap;\">Esse guia \u00E9 pensado para o Davinci Resolve, mas se voc\u00EA t\u00EAm dom\u00EDnio sobre outras aplica\u00E7\u00F5es, tenho certeza de que vai conseguir traduzir tranquilamente os conhecimentos daqui.</p><h1 style=\"white-space:pre-wrap;\">1. Organizar a m\u00EDdia</h1><p class=\"\" style=\"white-space:pre-wrap;\">O primeiro passo \u00E9 simples: precisamos organizar a m\u00EDdia dentro do software de nossa escolha para a coloriza\u00E7\u00E3o, depois de importadas. Estou assumindo que voc\u00EA deu conta de todas as etapas do recebimento desses arquivos do editor.</p><p class=\"\" style=\"white-space:pre-wrap;\">Esse \u00E9, honestamente, o momento menos importante de todos, e portanto n\u00E3o tenho tantas dicas aqui. Dito isso, vai sim ser necess\u00E1rio completar esse passo de uma maneira ou outra.</p><p class=\"\" style=\"white-space:pre-wrap;\">Para fazer a organiza\u00E7\u00E3o, sugiro que voc\u00EA jogue os arquivos crus todos dentro de uma pasta com justamente esse nome, e que as timelines fiquem fora dessa pasta. Dessa maneira, tudo fica mais f\u00E1cil de ser organizado.</p><p class=\"\" style=\"white-space:pre-wrap;\">Fazer do jeito que voc\u00EA j\u00E1 est\u00E1 acostumado pode ser uma \u00F3tima alternativa tamb\u00E9m. Talvez voc\u00EA j\u00E1 \u00E9 melhor do que eu nessa etapa, ou talvez mudar de processo de organiza\u00E7\u00E3o de m\u00EDdias n\u00E3o seja produtivo se voc\u00EA j\u00E1 est\u00E1 habituado com um.</p><h1 style=\"white-space:pre-wrap;\">2. Criar a Timeline</h1><p class=\"\" style=\"white-space:pre-wrap;\">O pr\u00F3ximo passo \u00E9 criar a Timeline. Lembre-se que em alguns softwares (especialmente o Davinci Resolve), n\u00E3o \u00E9 poss\u00EDvel mudar o FPS depois de j\u00E1 ter definido no momento da cria\u00E7\u00E3o. Portanto, tenha a certeza de que essa etapa ser\u00E1 cumprida corretamente.</p><p class=\"\" style=\"white-space:pre-wrap;\">Em rela\u00E7\u00E3o \u00E0 resolu\u00E7\u00E3o, ela pode ser alterada \u00E0 qualquer momento. Ent\u00E3o, de come\u00E7o, sugiro que voc\u00EA crie a Timeline com uma que n\u00E3o vai impedir que voc\u00EA fa\u00E7a o seu trabalho corretamente, mas tamb\u00E9m n\u00E3o \u00E9 necess\u00E1rio que seja a resolu\u00E7\u00E3o do sensor da c\u00E2mera. Isso porque voc\u00EA vai ficar limitado em rela\u00E7\u00E3o ao desempenho do seu computador sem necessidade. (Fique tranquilo. Nos momentos necess\u00E1rios, a resolu\u00E7\u00E3o vai ser modificada).</p><p class=\"\" style=\"white-space:pre-wrap;\">Obviamente, tamb\u00E9m vai ser necess\u00E1rio que voc\u00EA coloque todos os arquivos nessa timeline, se \u00E9 que j\u00E1 n\u00E3o a criou com base neles.</p><p class=\"\" style=\"white-space:pre-wrap;\">Aqui tamb\u00E9m estou assumindo que voc\u00EA deu conta do processo de divis\u00E3o do arquivo ProRes, DNxHR ou qualquer que seja o codec. Ou ainda, que deu conta de importar o XML/EDL se for necess\u00E1rio.</p><h1 style=\"white-space:pre-wrap;\">3. Separar os clips em grupos</h1><p class=\"\" style=\"white-space:pre-wrap;\">Basicamente esse passo se refere \u00E0 preparar a possibilidade de fazer corre\u00E7\u00F5es \u00FAnicas para uma cena toda ou para todos os cortes de um modelo de c\u00E2mera. Ent\u00E3o, se voc\u00EA est\u00E1 em algum outro software que n\u00E3o o Davinci Resolve, voc\u00EA vai precisar encontrar o equivalente \u00E0 ferramenta de Grupos.</p><p class=\"\" style=\"white-space:pre-wrap;\">No Davinci Resolve, \u00E9 agora o momento que voc\u00EA precisa separar todos os cortes do filme em grupos para facilitar a coloriza\u00E7\u00E3o. A melhor forma para fazer isso \u00E9 por modelo de c\u00E2mera (mais precisamente espa\u00E7o de cor e gamma de entrada), ou por cena.</p><h1 style=\"white-space:pre-wrap;\">4. Fazer o Gerenciamento de Cor</h1><p class=\"\" style=\"white-space:pre-wrap;\">Esse \u00E9 o momento que se faz necess\u00E1rio fazer o gerenciamento de cores. Portanto, voc\u00EA precisa escolher se vai usar um espa\u00E7o de cor e gamma intermedi\u00E1rios, ou se vai preferir trabalhar somente com os da c\u00E2mera e o de sa\u00EDda. Se decidir seguir pelo caminho do intermedi\u00E1rio, voc\u00EA precisa decidir qual.</p><p class=\"\" style=\"white-space:pre-wrap;\">E, em seguida, colocar em pr\u00E1tica esse Gerenciamento de Cores.</p><p class=\"\" style=\"white-space:pre-wrap;\">Antes do Look, pode ser que voc\u00EA queira fazer algum ajuste de exposi\u00E7\u00E3o b\u00E1sico aqui tamb\u00E9m, na cena toda, caso as imagens estejam com uma exposi\u00E7\u00E3o muito diferente do objetivo desejado. No Davinci Resolve, eu sugiro que esse ajuste fique na \u00E1rvore de nodes Group Pre-Clip.</p><h1 style=\"white-space:pre-wrap;\">5. Criar o Look</h1><p class=\"\" style=\"white-space:pre-wrap;\">ANTES DE FAZER O BALANCE \u00E9 necess\u00E1rio fazer o Look, ou, como eu gosto de chamar: a transforma\u00E7\u00E3o criativa de n\u00EDvel global.</p><p class=\"\" style=\"white-space:pre-wrap;\">Isso porque, diferente dos outros transformadores que usamos at\u00E9 agora, essa vai ser uma transforma\u00E7\u00E3o puramente criativa, e que vai ser pensada para todo o universo do projeto. Ou seja, ela precisa afetar TODOS os cortes do nosso projeto. No Davinci Resolve, normalmente fazemos isso na \u00E1rvore de Nodes da Timeline.</p><p class=\"\" style=\"white-space:pre-wrap;\">A \u00FAnica exce\u00E7\u00E3o \u00E9 se vamos ter universos diferentes ao longo do projeto: flashbacks, filmes de multiverso, mudan\u00E7as de \u00E9pocas ou planetas. Nesse caso, vai ser necess\u00E1rio agrupar as filmagens por universo para que seja poss\u00EDvel fazer o Look por grupo.</p><p class=\"\" style=\"white-space:pre-wrap;\">Um look consiste de pelo menos 3 etapas: Contraste Criativo, Ajuste de Cores e Textura. No entanto, o Look tamb\u00E9m pode ser apoiado por qualquer que seja a ferramenta de sua escolha, que vai permitir com que o projeto atinja o resultado desejado.</p><p class=\"\" style=\"white-space:pre-wrap;\">\u00C9 nesse momento que voc\u00EA t\u00EAm liberdade para emular qualquer que seja o modelo de filme, usar aquele Plugin ou OpenFX que sempre quis testar. A criatividade te permite fazer qualquer coisa.</p><p class=\"\" style=\"white-space:pre-wrap;\">E tamb\u00E9m, logo antes de trabalhar na textura, \u00E9 necess\u00E1rio que voc\u00EA volte a timeline para a maior resolu\u00E7\u00E3o que o conte\u00FAdo em quest\u00E3o vai ser distribu\u00EDdo. E ter um monitor com essa mesma resolu\u00E7\u00E3o tamb\u00E9m vai te permitir visualizar a textura da mesma forma que o expectador. Logo depois que voc\u00EA finalizar todo o trabalho de textura, \u00E9 poss\u00EDvel voltar para a resolu\u00E7\u00E3o de trabalho.</p><h1 style=\"white-space:pre-wrap;\">6. Ajuste b\u00E1sico de exposi\u00E7\u00E3o e Balance por cena</h1><p class=\"\" style=\"white-space:pre-wrap;\">A partir do momento que o look j\u00E1 est\u00E1 no lugar e aprovado pelo cliente, \u00E9 hora de fazer o ajuste b\u00E1sico da cena. Seguidamente, por exemplo, a exposi\u00E7\u00E3o n\u00E3o estava exatamente no lugar quando o cinemat\u00F3grafo gravou. \u00C9 prov\u00E1vel tamb\u00E9m que a imagem n\u00E3o estava 100% balanceada, mesmo que o balan\u00E7o de branco tenha sido selecionado corretamente na c\u00E2mera.</p><p class=\"\" style=\"white-space:pre-wrap;\">Portanto, agora \u00E9 a hora de corrigir ambas essas caracter\u00EDsticas da imagem no Group Pre-Clip. Tudo isso vai ocorrer enquanto voc\u00EA olha para essa imagem passando pelo look.</p><h1 style=\"white-space:pre-wrap;\">7 e 8. Primeira passada de Shot Matching ou Ajuste Criativo de Cena</h1><p class=\"\" style=\"white-space:pre-wrap;\">\u00C9 prov\u00E1vel que algumas cenas exijam algum trabalho criativo espec\u00EDfico delas. Talvez um preto-e-branco. Talvez um n\u00EDvel de satura\u00E7\u00E3o diferente. Talvez at\u00E9 um Glow ou Bloom nos Highlights Esse passo normalmente est\u00E1 na \u00E1rvore de nodes do grupo p\u00F3s-clip.</p><p class=\"\" style=\"white-space:pre-wrap;\">Depois que a criatividade toda praticamente acabou, \u00E9 hora de fazer a primeira passada de Shot Matching. Eu sugiro fortemente que essa seja focada em ajustes de exposi\u00E7\u00E3o e contraste, e que n\u00E3o seja focada em cores. O olho humano \u00E9 mais sens\u00EDvel \u00E0 mudan\u00E7as de lumin\u00E2ncia do que de cor, e portanto a primeira tem prioridade.</p><h1 style=\"white-space:pre-wrap;\">9. Shot Matching</h1><p class=\"\" style=\"white-space:pre-wrap;\">Agora sim voc\u00EA pode para passar por todos os takes e ajustar tudo o que parece n\u00E3o combinar, e deveria combinar. 90% do trabalho de matching \u00E9 puro offset.</p><p class=\"\" style=\"white-space:pre-wrap;\">Dito isso, \u00E9 mais importante que cada take esteja bonito, do que combine. Se for necess\u00E1rio fazer algum ficar levemente mais frio ou mais magenta para ficar mais bonito, se permita fazer isso. O expectador est\u00E1 vendo um take atr\u00E1s do outro e n\u00E3o ambos ao mesmo tempo. \u00C9 dif\u00EDcil que consiga comparar.</p><p class=\"\" style=\"white-space:pre-wrap;\">Esses ajustes ocorrem na \u00E1rvore de nodes do clip.</p><h1 style=\"white-space:pre-wrap;\">10. Ajustes locais clip \u00E0 clip.</h1><p class=\"\" style=\"white-space:pre-wrap;\">A partir desse momento o seu projeto j\u00E1 DEVE estar bonito, independente dos ajustes locais clip-\u00E0-clip.</p><p class=\"\" style=\"white-space:pre-wrap;\">Outros ajustes que ocorrem clip \u00E0 clip s\u00E3o as janelas, qualifiers e tratamento de pele. Esses s\u00E3o dificilmente aproveitados de um corte para outro. Portanto, precisam de um alto cuidado, porque podem quebrar muito facilmente ao longo de v\u00E1rios clips.</p><p class=\"\" style=\"white-space:pre-wrap;\">Caso voc\u00EA queira trabalhar na textura da pele, talvez tamb\u00E9m seja importante fazer isso olhando para a imagem na resolu\u00E7\u00E3o que vai ser distribuida.</p><p class=\"\" style=\"white-space:pre-wrap;\">\u00C9 importante destacar tamb\u00E9m que esses s\u00E3o de longe os ajustes que mais d\u00E3o trabalho e que menos d\u00E3o resultado. Portanto, os aplique apenas em projetos que merecem esse carinho, ou em projetos que voc\u00EA foi pago de maneira equivalente.</p><h1 style=\"white-space:pre-wrap;\">11. Entrega</h1><p class=\"\" style=\"white-space:pre-wrap;\">Agora chegou o momento da entrega, e, novamente, vamos mudar a resolu\u00E7\u00E3o. Agora para a mesma que voc\u00EA recebeu.</p><p class=\"\" style=\"white-space:pre-wrap;\">Aqui tamb\u00E9m, \u00E9 prov\u00E1vel que voc\u00EA precise aplicar os seus conhecimentos sobre codecs e conteiners, e que confira se est\u00E1 tudo bem com os seus ajustes, especialmente a textura, assistindo.</p><p class=\"\" style=\"white-space:pre-wrap;\">Para alguns, essas instru\u00E7\u00F5es podem parecer diferentes demais do que costumam fazer. No entanto, como um profissional da cor que vive disso \u00E0 pouco mais de meia d\u00E9cada, e que p\u00F4de estudar com os talentos de mais alto n\u00EDvel da cor mundial, tenho convic\u00E7\u00E3o de que se trata de conhecimento \u00FAtil.</p><p class=\"\" style=\"white-space:pre-wrap;\">Caso voc\u00EA queira receber mais conte\u00FAdo como esse, sugiro que deixe seu e-mail para eu te enviar conte\u00FAdos desse mesmo n\u00EDvel. Para fazer isso, toque no bot\u00E3o abaixo:</p></div>\n\n\n  \n<style id=\"container-styles\">#block-f464780f69740ea006b8 {\n    \n    --stroke-style: none;--stroke-thickness: 6px;\n    \n      \n      \n      \n    \n\n\n\n  }\n\n  #block-f464780f69740ea006b8 .sqs-html-content {\n    \n    --tweak-text-block-padding: 6% 6% 6% 6%;\n  --tweak-text-block-padding: initial;\n}\n\n  #block-f464780f69740ea006b8 {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      border-radius: var(--tweak-text-block-radius);\n  }\n\n  \n  \n#block-f464780f69740ea006b8 {\n      --tweak-text-block-radius: 0px 0px 0px 0px;\n    }\n\n\n  \n  \n\n  #block-f464780f69740ea006b8 {\n    }\n\n</style>\n\n<style id=\"override-container-styles\">\n    @media screen and (max-width: 767px) {\n          \n            \n\n#block-f464780f69740ea006b8 {\n            \n            }\n        }\n    \n  \n    @media screen and (max-width: 767px) {\n          #block-f464780f69740ea006b8 .sqs-html-content {\n            \n            }\n        }\n    \n  @media screen and (max-width: 767px) {\n          \n          \n\n          \n          \n          \n        }</style>\n<style class=\"transform-overrides-vars\">\n  \n</style>\n\n\n\n\n</div>\n</div></div><div class=